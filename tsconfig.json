{
	"compilerOptions": {
		// Environment setup & latest features
		"lib": ["ESNext"],
		"target": "ESNext",
		"module": "Preserve",
		"moduleDetection": "force",
		"jsx": "react-jsx",
		"allowJs": true,
		"types": ["bun"],

		// Bundler mode
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,

		// Best practices
		"strict": true,
		"skipLibCheck": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,

		// Some stricter flags (disabled by default)
		"noUnusedLocals": true,
		"noUnusedParameters": false,
		"noPropertyAccessFromIndexSignature": false,

		// `@/x` is `src/x`: resolved by Bun at run time and by tsdown at build time.
		"paths": { "@/*": ["./src/*"] }
	},
	// examples/ and tests/fixtures/ import .py files: they are type-checked through the mapper by the e2e tests.
	"include": ["src", "tests", "tsdown.config.ts"],
	"exclude": [
		"tests/fixtures",
		"tests/baselines",
		"tests/cases",
		"tests/.build"
	]
}
