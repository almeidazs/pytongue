{
	"compilerOptions": {
		"target": "esnext",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"strict": true,
		"noEmit": true,
		"verbatimModuleSyntax": true,
		"noUnusedLocals": true,
		"allowImportingTsExtensions": true,
		"types": []
	},
	"contentMappers": [{ "package": "pytongue", "extensions": [".py"] }],
	"include": ["src"]
}
