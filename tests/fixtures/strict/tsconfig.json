{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "types": []
  },
  "contentMappers": [{ "package": "pytongue", "extensions": [".py"], "options": { "strict": true } }],
  "include": ["src"]
}
