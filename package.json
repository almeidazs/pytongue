{
	"name": "pytongue",
	"version": "0.0.0",
	"description": "Import Python files from TypeScript: types come from the type hints, and calls run the real Python.",
	"license": "Apache-2.0",
	"files": [
		"dist",
		"grammar",
		"python/bridge.py",
		"python/pytongue_bridge/*.py"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/runtime.d.ts",
			"default": "./dist/runtime.js"
		},
		"./register": "./dist/register.js",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsdown",
		"test": "bun test",
		"typecheck": "bun check",
		"lint": "ultracite check",
		"lint:fix": "ultracite fix",
		"format": "ultracite fix",
		"prepare": "if [ -z \"$CI\" ] && [ -e .git ]; then lefthook install; fi",
		"verify": "ultracite check && bun check && bun test"
	},
	"dependencies": {
		"web-tree-sitter": "0.27.2"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@stylistic/eslint-plugin": "^6.0.0",
		"@types/bun": "latest",
		"@types/node": "^26.6.6",
		"lefthook": "^2.2.2",
		"oxfmt": "^0.78.0",
		"oxlint": "^1.93.0",
		"smol-toml": "^1.9.1",
		"tree-sitter-python": "0.25.0",
		"ts-content-mapper": "0.1.1",
		"tsdown": "^0.23.7",
		"typescript": "^7.1.0-beta",
		"ultracite": "^7.12.4"
	},
	"peerDependencies": {
		"typescript": ">=7.1.0-0"
	},
	"peerDependenciesMeta": {
		"typescript": {
			"optional": true
		}
	},
	"typescript": {
		"contentMapper": {
			"compilerOptions": [],
			"dynamicConfig": false,
			"exec": [
				"node",
				"dist/mapper.js"
			]
		}
	},
	"engines": {
		"node": ">=24"
	}
}
