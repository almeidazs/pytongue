{
	"name": "pytongue",
	"version": "0.0.0",
	"description": "Import Python files from TypeScript: types come from the type hints, and calls run the real Python.",
	"license": "Apache-2.0",
	"files": [
		"dist",
		"grammar",
		"python/bridge.py",
		"python/pytongue_bridge/*.py"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/runtime.d.ts",
			"default": "./dist/runtime.js"
		},
		"./register": "./dist/register.js",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsdown",
		"test": "bun test",
		"test:unit": "bun test tests/engine tests/runtime",
		"test:e2e": "bun test tests/e2e",
		"test:python": "cd python && uv run --quiet --no-project --python 3.12 --with pytest --with pytest-cov --with hypothesis --with 'pydantic>=2' pytest --cov --cov-fail-under=90",
		"coverage": "bun test --coverage",
		"baselines": "UPDATE_BASELINES=1 bun test tests/engine/corpus.test.ts tests/e2e/types.test.ts",
		"fuzz": "PYTONGUE_FUZZ=heavy PYTONGUE_FUZZ_SEED=$RANDOM bun test tests/engine/properties.test.ts tests/e2e/generated.test.ts",
		"typecheck": "bun check",
		"lint": "ultracite check",
		"lint:fix": "ultracite fix",
		"format": "ultracite fix",
		"verify": "ultracite check && bun check && bun test --coverage && bun run test:python",
		"bench": "bun run benchmark/run.ts"
	},
	"dependencies": {
		"web-tree-sitter": "0.27.2"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@stylistic/eslint-plugin": "^6.0.0",
		"@types/bun": "latest",
		"@types/node": "^26.6.6",
		"fast-check": "^4.10.2",
		"lefthook": "^2.2.2",
		"oxfmt": "^0.78.0",
		"oxlint": "^1.93.0",
		"smol-toml": "^1.9.1",
		"tree-sitter-python": "0.25.0",
		"ts-content-mapper": "0.1.1",
		"tsdown": "^0.23.7",
		"typescript": "^7.1.0-beta",
		"ultracite": "^7.12.4"
	},
	"peerDependencies": {
		"typescript": ">=7.1.0-0"
	},
	"peerDependenciesMeta": {
		"typescript": {
			"optional": true
		}
	},
	"typescript": {
		"contentMapper": {
			"compilerOptions": [],
			"dynamicConfig": false,
			"exec": [
				"node",
				"dist/mapper.js"
			]
		}
	},
	"engines": {
		"node": ">=24"
	}
}
